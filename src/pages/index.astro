---
import '../styles/global.css';
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>ZPPSU Institutional Developer Portfolio</title>
  </head>
  <body class="bg-canvas text-ink font-sans min-h-screen antialiased">
    <main class="max-w-6xl mx-auto px-6 py-16">
      <header class="mb-12">
        <h1 class="text-4xl font-extrabold tracking-tight font-display mb-4">
          ZPPSU Institutional Developer Portfolio
        </h1>
        <p class="text-ink-muted text-lg max-w-2xl">
          37 institutional software systems, sports management platforms, and offline-first classroom architectures.
        </p>
      </header>
      <div class="p-6 rounded-card border border-line bg-surface">
        <p class="text-sm font-mono text-accent">Scaffold initialized successfully. Ready for data ingestion (T-10..T-13).</p>
      </div>
    </main>
  </body>
</html>
