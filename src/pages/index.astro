---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BentoGrid from '../components/BentoGrid.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import DomainFilter from '../components/islands/DomainFilter';
import CaseStudyDrawer from '../components/islands/CaseStudyDrawer';

const allProjects = await getCollection('projects');

// Sort: Flagships first, then live cloud, then alphabetical
const sortedProjects = [...allProjects].sort((a, b) => {
  if (a.data.featured !== b.data.featured) {
    return a.data.featured ? -1 : 1;
  }
  if (a.data.status === 'live' && b.data.status !== 'live') {
    return -1;
  }
  if (b.data.status === 'live' && a.data.status !== 'live') {
    return 1;
  }
  return a.data.title.localeCompare(b.data.title);
});

// Build domain counts dynamically
const domainCounts: Record<string, number> = {};
for (const p of allProjects) {
  domainCounts[p.data.domain] = (domainCounts[p.data.domain] || 0) + 1;
}

const liveCount = allProjects.filter(p => p.data.status === 'live').length;
domainCounts['live'] = liveCount;
const lanCount = allProjects.filter(p => p.data.status === 'offline-lan').length;
const totalCount = allProjects.length;

// Projects data array for the client drawer island
const projectsData = sortedProjects.map(p => p.data);
---

<BaseLayout title="Duane Chino Atis (Duane Luy) — AI Application Developer & Systems Architect">
  <div class="space-y-12">
    <!-- Hero Section with Staggered Entrance Reveals -->
    <section class="space-y-6 pt-4 pb-4 border-b border-[var(--color-line)]">
      <div class="space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
          <div
            class="scroll-reveal inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono bg-[var(--color-surface-2)] text-[var(--color-ink-muted)] border border-[var(--color-line)] shadow-xs"
            data-delay="0"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>ZPPSU Computer Technology & AI Systems</span>
          </div>
          <span
            class="scroll-reveal hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono text-[var(--color-ink-muted)]/80 bg-[var(--color-surface-2)]/60 border border-[var(--color-line)]"
            data-delay="40"
          >
            <span class="text-emerald-500">SYS_LOC:</span> 6.9214° N, 122.0790° E // 38 SYSTEMS
          </span>
        </div>
        <h1
          class="scroll-reveal text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight font-display text-[var(--color-ink)] leading-tight"
          data-delay="80"
        >
          Duane Chino Atis <span class="text-xl sm:text-2xl lg:text-3xl font-normal text-[var(--color-ink-muted)] font-mono">(Duane Luy)</span>
        </h1>
        <p
          class="scroll-reveal text-base sm:text-xl font-semibold text-emerald-600 dark:text-emerald-400 max-w-2xl"
          data-delay="140"
        >
          AI Application Developer · LLM Solutions Engineer · Full-Stack Systems Architect
        </p>
      </div>

      <p
        class="scroll-reveal text-sm sm:text-base text-[var(--color-ink-muted)] max-w-3xl leading-relaxed"
        data-delay="200"
      >
        Shipped <strong>38 software systems</strong> — including 11 live production web apps on Cloudflare Workers and Supabase, conversational AI tutors with cloud & local LLM routing, Socratic board exam reviewers, and offline-first campus platforms. I bridge institutional requirements with practical, high-performance software.
      </p>

      <!-- High-Conversion Action CTA Buttons -->
      <div class="scroll-reveal flex flex-wrap items-center gap-3 pt-1 pb-2" data-delay="240">
        <a
          href="#services"
          class="tactile-press inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-emerald-600 hover:bg-emerald-500 text-white shadow-md shadow-emerald-950/20 transition-all hover:scale-105"
        >
          <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
          <span>Available for Gigs & MVPs</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <a
          href="mailto:imdcluy@gmail.com"
          class="tactile-press inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-[var(--color-surface)] hover:bg-[var(--color-surface-2)] text-[var(--color-ink)] border border-[var(--color-line)] transition-all"
        >
          <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Get in Touch (Email)</span>
        </a>
        <a
          href="#catalog"
          class="tactile-press inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-medium text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] transition-colors"
        >
          <span>Explore 38 Systems ↓</span>
        </a>
      </div>

      <!-- Key Engineering Metrics Banner with Dynamic Numeric Rollup -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-2">
        <div
          class="scroll-reveal cyber-card group relative p-4 rounded-xl bg-[var(--color-surface)] border border-[var(--color-line)] hover:border-[var(--color-accent)]/50 hover:-translate-y-0.5 transition-all duration-300 shadow-xs overflow-hidden"
          data-delay="260"
          data-sound-hover="true"
        >
          <div class="specular-sheen" aria-hidden="true"></div>
          <div class="text-2xl sm:text-3xl font-bold font-mono text-[var(--color-ink)]">
            <span data-counter-target={String(totalCount)}>{totalCount}</span>
          </div>
          <div class="text-xs font-medium text-[var(--color-ink-muted)] mt-1">Software Systems</div>
          <div class="absolute -right-2 -bottom-2 w-12 h-12 bg-emerald-500/5 rounded-full blur-xl group-hover:bg-emerald-500/15 transition-all"></div>
        </div>

        <div
          class="scroll-reveal cyber-card group relative p-4 rounded-xl bg-[var(--color-surface)] border border-[var(--color-line)] hover:border-emerald-500/50 hover:-translate-y-0.5 transition-all duration-300 shadow-xs overflow-hidden"
          data-delay="320"
          data-sound-hover="true"
        >
          <div class="specular-sheen" aria-hidden="true"></div>
          <div class="text-2xl sm:text-3xl font-bold font-mono text-emerald-600 dark:text-emerald-400">
            <span data-counter-target={String(liveCount)}>{liveCount}</span>
          </div>
          <div class="text-xs font-medium text-[var(--color-ink-muted)] mt-1">Live Production Apps</div>
          <div class="absolute -right-2 -bottom-2 w-12 h-12 bg-emerald-500/10 rounded-full blur-xl group-hover:bg-emerald-500/20 transition-all"></div>
        </div>

        <div
          class="scroll-reveal cyber-card group relative p-4 rounded-xl bg-[var(--color-surface)] border border-[var(--color-line)] hover:border-indigo-500/50 hover:-translate-y-0.5 transition-all duration-300 shadow-xs overflow-hidden"
          data-delay="380"
          data-sound-hover="true"
        >
          <div class="specular-sheen" aria-hidden="true"></div>
          <div class="text-2xl sm:text-3xl font-bold font-mono text-indigo-600 dark:text-indigo-400">
            <span data-counter-target={`${lanCount}+`}>{lanCount}+</span>
          </div>
          <div class="text-xs font-medium text-[var(--color-ink-muted)] mt-1">Offline LAN Deployments</div>
          <div class="absolute -right-2 -bottom-2 w-12 h-12 bg-indigo-500/10 rounded-full blur-xl group-hover:bg-indigo-500/20 transition-all"></div>
        </div>

        <div
          class="scroll-reveal cyber-card group relative p-4 rounded-xl bg-[var(--color-surface)] border border-[var(--color-line)] hover:border-amber-500/50 hover:-translate-y-0.5 transition-all duration-300 shadow-xs overflow-hidden"
          data-delay="440"
          data-sound-hover="true"
        >
          <div class="specular-sheen" aria-hidden="true"></div>
          <div class="text-2xl sm:text-3xl font-bold font-mono text-[var(--color-ink)]">
            <span data-counter-target="$0/mo">$0/mo</span>
          </div>
          <div class="text-xs font-medium text-[var(--color-ink-muted)] mt-1">Serverless Edge Cost</div>
          <div class="absolute -right-2 -bottom-2 w-12 h-12 bg-amber-500/5 rounded-full blur-xl group-hover:bg-amber-500/15 transition-all"></div>
        </div>
      </div>
    </section>

    <!-- Marquee Bento Hero (Flagships) -->
    <BentoGrid projects={sortedProjects} />

    <!-- Full Categorized Catalog -->
    <section id="catalog" class="space-y-6 pt-4">
      <div class="scroll-reveal flex flex-col sm:flex-row sm:items-end justify-between gap-3" data-delay="0">
        <div>
          <h2 class="font-display font-bold text-2xl sm:text-3xl text-[var(--color-ink)]">
            Complete Systems Directory
          </h2>
          <p class="text-sm text-[var(--color-ink-muted)] mt-1">
            Filter through all 38 systems across university operations, sports tournaments, AI tools, and offline hubs.
          </p>
        </div>
        <span class="text-xs font-mono text-[var(--color-ink-muted)]">
          Click any card to inspect architecture, live preview & operational walkthrough
        </span>
      </div>

      <!-- Zero-Lag Domain Filter Island -->
      <DomainFilter
        client:idle
        counts={domainCounts}
        totalCount={totalCount}
      />

      <!-- Static HTML Grid (Pure CSS Filter Matching) -->
      <ProjectGrid projects={sortedProjects} />
    </section>

    <!-- High-Converting Freelance Services & Side Hustle Section -->
    <section id="services" class="scroll-reveal my-12 pt-8 pb-4 border-t border-[var(--color-line)] space-y-8" data-delay="0">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
            <span>Now Accepting Gigs & Sprint Contracts</span>
          </div>
          <h2 class="font-display font-bold text-2xl sm:text-3xl lg:text-4xl text-[var(--color-ink)]">
            Services & Rapid Build Sprints
          </h2>
          <p class="text-sm text-[var(--color-ink-muted)] mt-1 max-w-2xl">
            Stop waiting 6 months for traditional dev agencies. I build, polish, and launch full-stack web apps and operational internal tools in 3 to 7 days.
          </p>
        </div>
        <a
          href="mailto:imdcluy@gmail.com?subject=Project%20Inquiry%20-%20Rapid%20Build%20Sprint"
          class="tactile-press inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-emerald-600 hover:bg-emerald-500 text-white shadow-md shadow-emerald-950/20 transition-all shrink-0"
        >
          <span>Book a 7-Day Sprint</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Service 1 -->
        <div class="cyber-card p-6 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-line)] hover:border-emerald-500/50 transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg">
              01
            </div>
            <h3 class="font-display font-bold text-xl text-[var(--color-ink)]">
              Spreadsheet-to-Web App
            </h3>
            <p class="text-xs text-[var(--color-ink-muted)] leading-relaxed">
              Turn fragile Excel sheets or chaotic Google Drives into a secure, role-based internal web portal with real-time dashboards and CSV exports.
            </p>
            <ul class="text-xs space-y-1.5 text-[var(--color-ink)]/80 pt-2 font-mono">
              <li class="flex items-center gap-2">✓ Multi-role logins (Admin, Staff, Auditor)</li>
              <li class="flex items-center gap-2">✓ Automated arithmetic validation & charts</li>
              <li class="flex items-center gap-2">✓ Delivered in 3 to 5 business days</li>
            </ul>
          </div>
          <div class="pt-6 border-t border-[var(--color-line)] mt-6 flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">$600 – $1,500</span>
            <a href="mailto:imdcluy@gmail.com?subject=Spreadsheet%20to%20Web%20App" class="text-xs font-medium text-[var(--color-accent)] hover:underline">Inquire →</a>
          </div>
        </div>

        <!-- Service 2 -->
        <div class="cyber-card p-6 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-line)] hover:border-indigo-500/50 transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-3 right-3 text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20">
            HIGH DEMAND
          </div>
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg">
              02
            </div>
            <h3 class="font-display font-bold text-xl text-[var(--color-ink)]">
              AI Prototype Finisher
            </h3>
            <p class="text-xs text-[var(--color-ink-muted)] leading-relaxed">
              Did you build a frontend prototype in v0, Lovable, or Cursor? I wire up Supabase Auth, PostgreSQL schemas, Row-Level Security, and Stripe payments.
            </p>
            <ul class="text-xs space-y-1.5 text-[var(--color-ink)]/80 pt-2 font-mono">
              <li class="flex items-center gap-2">✓ Fix state bugs & broken API routes</li>
              <li class="flex items-center gap-2">✓ Production deploy on Cloudflare/Vercel</li>
              <li class="flex items-center gap-2">✓ 72-Hour Rapid Rescue Sprint</li>
            </ul>
          </div>
          <div class="pt-6 border-t border-[var(--color-line)] mt-6 flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400">$400 – $950</span>
            <a href="mailto:imdcluy@gmail.com?subject=AI%20Prototype%20Rescue" class="text-xs font-medium text-indigo-500 hover:underline">Inquire →</a>
          </div>
        </div>

        <!-- Service 3 -->
        <div class="cyber-card p-6 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-line)] hover:border-amber-500/50 transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-lg">
              03
            </div>
            <h3 class="font-display font-bold text-xl text-[var(--color-ink)]">
              7-Day Startup MVP
            </h3>
            <p class="text-xs text-[var(--color-ink-muted)] leading-relaxed">
              From your idea or Figma wireframe to a live, payment-ready SaaS application with 1 core AI feature and $0/month serverless architecture.
            </p>
            <ul class="text-xs space-y-1.5 text-[var(--color-ink)]/80 pt-2 font-mono">
              <li class="flex items-center gap-2">✓ Next.js 16 + React 19 + Supabase</li>
              <li class="flex items-center gap-2">✓ Stripe billing + custom domain setup</li>
              <li class="flex items-center gap-2">✓ 100% clean code you own completely</li>
            </ul>
          </div>
          <div class="pt-6 border-t border-[var(--color-line)] mt-6 flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-amber-600 dark:text-amber-400">$1,500 – $2,800</span>
            <a href="mailto:imdcluy@gmail.com?subject=Startup%20MVP%20Build" class="text-xs font-medium text-amber-500 hover:underline">Inquire →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Case Study Drawer Island -->
    <CaseStudyDrawer client:idle projects={projectsData} />

    <!-- Footer -->
    <footer class="scroll-reveal pt-12 pb-8 border-t border-[var(--color-line)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[var(--color-ink-muted)]" data-delay="60">
      <div>
        <span>Duane Luy (`imdcluy`) · ZPPSU AMBC</span>
      </div>
      <div class="flex items-center gap-4">
        <span>Astro 5 SSG</span>
        <span>•</span>
        <span>Cloudflare Pages</span>
        <span>•</span>
        <a
          href="https://github.com/imdcluy-ctrl"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--color-ink)] transition-colors tactile-press"
        >
          GitHub Profile
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>
