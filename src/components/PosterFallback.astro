---
interface Props {
  name: string;
  slug: string;
  domain: string;
  stack?: string[];
  class?: string;
}

const { name, slug, domain, stack = [], class: className = '' } = Astro.props;

// Simple deterministic hash from slug to vary pattern & density
function hashString(str: string): number {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = (hash << 5) - hash + str.charCodeAt(i);
    hash |= 0;
  }
  return Math.abs(hash);
}

const hash = hashString(slug);
const gridSize = 16 + (hash % 16); // 16px - 32px
const dotOpacity = 0.08 + ((hash % 10) / 100); // 0.08 - 0.18

// Domain specific accent color
const domainAccents: Record<string, string> = {
  institutional: '#059669', // Emerald
  sports: '#D97706',        // Amber
  edtech: '#4F46E5',        // Indigo
  'offline-lan': '#2563EB',  // Blue
  platforms: '#7C3AED',    // Violet
};

const accent = domainAccents[domain] || '#4F46E5';
const topTags = stack.slice(0, 3);
---

<div
  class={`relative overflow-hidden w-full h-full min-h-[160px] flex flex-col justify-between p-5 select-none bg-[var(--color-surface)] border border-[var(--color-line)] rounded-[inherit] ${className}`}
  style={`background-image: radial-gradient(${accent} ${dotOpacity * 100}%, transparent 1px); background-size: ${gridSize}px ${gridSize}px;`}
>
  <!-- Subtle accent gradient corner -->
  <div
    class="absolute -top-12 -right-12 w-32 h-32 rounded-full blur-2xl pointer-events-none opacity-20"
    style={`background-color: ${accent};`}
  />

  <div class="relative z-10 flex items-center justify-between gap-2">
    <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-ink-muted)] border border-[var(--color-line)]">
      {domain}
    </span>
    <span class="w-2 h-2 rounded-full" style={`background-color: ${accent};`} />
  </div>

  <div class="relative z-10 my-auto py-2">
    <h4 class="font-display font-bold text-base md:text-lg leading-snug text-[var(--color-ink)] line-clamp-2">
      {name}
    </h4>
  </div>

  <div class="relative z-10 flex flex-wrap gap-1.5 pt-1">
    {topTags.map((tech) => (
      <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-ink-muted)]">
        {tech}
      </span>
    ))}
  </div>
</div>
