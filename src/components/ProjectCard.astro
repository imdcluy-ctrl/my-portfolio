---
import type { CollectionEntry } from 'astro:content';
import StatusPill from './StatusPill.astro';
import TechBadge from './TechBadge.astro';
import PosterFallback from './PosterFallback.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const p = project.data;

const allStack = [...(p.stack.frontend || []), ...(p.stack.backend || []), ...(p.stack.data || [])];
const topBadges = allStack.slice(0, 3);
const remainingCount = allStack.length - topBadges.length;
---

<article
  class="scroll-reveal group relative flex flex-col justify-between h-full rounded-[var(--radius-card)] bg-[var(--color-surface)] border border-[var(--color-line)] overflow-hidden transition-all duration-300 hover:border-[var(--color-accent)]/50 hover:-translate-y-1 hover:shadow-xl hover:shadow-emerald-950/20 focus-within:ring-2 focus-within:ring-[var(--color-accent)]"
>
  <!-- Subtle Ambient Specular Sheen -->
  <div
    class="pointer-events-none absolute -inset-px rounded-[var(--radius-card)] opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-tr from-emerald-500/8 via-transparent to-indigo-500/12 z-20"
    aria-hidden="true"
  ></div>

  <!-- Card Hero / Poster Media (16:10 aspect ratio) -->
  <div class="relative w-full aspect-[16/10] bg-[var(--color-surface-2)] overflow-hidden border-b border-[var(--color-line)]">
    {p.hero ? (
      <img
        src={p.hero}
        alt={`${p.title} preview`}
        class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <PosterFallback
        name={p.title}
        slug={project.id}
        domain={p.domain}
        stack={allStack}
      />
    )}

    <!-- Category tag pill overlay -->
    <div class="absolute top-2.5 left-2.5 z-10">
      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[var(--color-surface)]/90 backdrop-blur-xs text-[var(--color-ink)] border border-[var(--color-line)]">
        {p.domainLabel}
      </span>
    </div>

    <!-- Live Demo Badge Overlay for Cloud Apps -->
    {p.status === 'live' && p.links.live && (
      <a
        href={p.links.live}
        target="_blank"
        rel="noopener noreferrer"
        class="tactile-press absolute top-2.5 right-2.5 z-10 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-semibold bg-emerald-600/90 hover:bg-emerald-600 text-white shadow-xs backdrop-blur-xs transition-all hover:scale-105 cursor-pointer"
        title={`Open live production app for ${p.title}`}
      >
        <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse" />
        <span>Live Demo</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    )}
  </div>

  <!-- Content Block -->
  <div class="flex flex-col flex-1 p-5 justify-between gap-4">
    <div>
      <div class="flex items-center justify-between gap-2 mb-2">
        <StatusPill status={p.status} />
        {p.highlightMetric && (
          <span class="text-[11px] font-mono font-medium text-[var(--color-accent)]">
            {p.highlightMetric.value}
          </span>
        )}
      </div>

      <h3 class="font-display font-semibold text-lg text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors line-clamp-1">
        {p.title}
      </h3>

      <p class="mt-1.5 text-xs text-[var(--color-ink-muted)] line-clamp-2 leading-relaxed">
        {p.tagline}
      </p>
    </div>

    <!-- Card Footer -->
    <div class="pt-3 border-t border-[var(--color-line)] flex items-center justify-between gap-2">
      <div class="flex items-center gap-1.5 overflow-hidden flex-wrap">
        {topBadges.map(tech => <TechBadge name={tech} />)}
        {remainingCount > 0 && (
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-ink-muted)]">
            +{remainingCount}
          </span>
        )}
      </div>

      <div class="flex items-center gap-2 shrink-0">
        {p.status === 'live' && p.links.live && (
          <a
            href={p.links.live}
            target="_blank"
            rel="noopener noreferrer"
                class="tactile-press inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 transition-colors"
            title="Launch Live Production App"
          >
            <span>Open App</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
        <button
          type="button"
          data-project={project.id}
          class="case-study-trigger tactile-press text-xs font-medium text-[var(--color-ink)] hover:text-[var(--color-accent)] flex items-center gap-1 shrink-0 cursor-pointer p-1 rounded focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent)]"
          aria-label={`Open case study for ${p.title}`}
        >
          <span>Details</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</article>
