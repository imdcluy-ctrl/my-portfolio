---
import type { CollectionEntry } from 'astro:content';
import StatusPill from './StatusPill.astro';
import TechBadge from './TechBadge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  featuredTier?: 'duo' | 'spotlight' | 'standard';
}

const { project, index, featuredTier = 'standard' } = Astro.props;
const p = project.data;

const allStack = [...(p.stack.frontend || []), ...(p.stack.backend || []), ...(p.stack.data || [])];
const topBadges = allStack.slice(0, 4);
const orderNumber = String(p.bentoOrder || index + 1).padStart(2, '0');
---

{featuredTier === 'duo' && (
  <div
    class="scroll-reveal bento-stagger cyber-card group relative overflow-hidden flex flex-col justify-between rounded-[var(--radius-tile)] bg-[var(--color-surface)] border border-[var(--color-line)] p-6 transition-all duration-300 hover:border-[var(--color-accent)]/60 hover:shadow-xl hover:shadow-emerald-950/20 focus-within:ring-2 focus-within:ring-[var(--color-accent)]"
    style={`--i: ${index};`}
    data-sound-hover="true"
  >
    <!-- Dynamic Specular Cursor-Tracked Light Sheen -->
    <div class="specular-sheen" aria-hidden="true"></div>

    <!-- Cybernetic HUD Corner Brackets -->
    <span class="absolute top-2 left-2.5 text-[9px] font-mono text-[var(--color-line)] group-hover:text-emerald-500/60 transition-colors pointer-events-none select-none" aria-hidden="true">┌</span>
    <span class="absolute top-2 right-2.5 text-[9px] font-mono text-[var(--color-line)] group-hover:text-emerald-500/60 transition-colors pointer-events-none select-none" aria-hidden="true">┐</span>
    <span class="absolute bottom-2 left-2.5 text-[9px] font-mono text-[var(--color-line)] group-hover:text-emerald-500/60 transition-colors pointer-events-none select-none" aria-hidden="true">└</span>
    <span class="absolute bottom-2 right-2.5 text-[9px] font-mono text-[var(--color-line)] group-hover:text-emerald-500/60 transition-colors pointer-events-none select-none" aria-hidden="true">┘</span>

    <!-- Dynamic Specular Aurora Sheen -->
    <div
      class="pointer-events-none absolute -inset-px rounded-[var(--radius-tile)] opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-tr from-emerald-500/10 via-transparent to-indigo-500/15 z-10"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <StatusPill status={p.status} />
        <span class="text-xs font-mono text-[var(--color-ink-muted)]">Flagship {orderNumber}</span>
      </div>
      <div class="flex items-center gap-1.5 flex-wrap">
        {topBadges.slice(0, 3).map(tech => <TechBadge name={tech} />)}
      </div>
    </div>

    <div class="relative z-10 my-5 space-y-2">
      <h3 class="font-display font-bold text-2xl sm:text-3xl text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">
        {p.title}
      </h3>
      <p class="text-sm text-[var(--color-ink-muted)] line-clamp-3 leading-relaxed">
        {p.tagline}
      </p>
    </div>

    <div class="relative z-10 flex items-center justify-between pt-4 border-t border-[var(--color-line)]">
      <span class="text-xs font-mono text-[var(--color-ink-muted)]">
        {p.domainLabel}
      </span>
      <div class="flex items-center gap-2">
        {p.status === 'live' && p.links.live && (
          <a
            href={p.links.live}
            target="_blank"
            rel="noopener noreferrer"
            class="tactile-press inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-emerald-600 text-white hover:bg-emerald-700 transition-all shadow-xs"
          >
            <span>Live App</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
        <button
          type="button"
          data-project={project.id}
          class="case-study-trigger tactile-press inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-medium bg-[var(--color-surface-2)] text-[var(--color-ink)] border border-[var(--color-line)] hover:bg-[var(--color-accent)] hover:text-white hover:border-transparent transition-all cursor-pointer shadow-xs"
        >
          <span>Case Study</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
)}

{featuredTier === 'spotlight' && (
  <div
    class="scroll-reveal bento-stagger cyber-card group relative overflow-hidden flex flex-col justify-between rounded-[var(--radius-tile)] bg-[var(--color-surface)] border border-[var(--color-line)] p-6 sm:p-8 transition-all duration-300 hover:border-indigo-500/60 hover:shadow-2xl hover:shadow-indigo-950/25 focus-within:ring-2 focus-within:ring-indigo-500"
    style={`--i: ${index};`}
    data-sound-hover="true"
  >
    <!-- Dynamic Specular Cursor-Tracked Light Sheen -->
    <div class="specular-sheen" aria-hidden="true"></div>

    <!-- Cybernetic HUD Corner Brackets -->
    <span class="absolute top-2.5 left-3 text-[10px] font-mono text-[var(--color-line)] group-hover:text-indigo-400/70 transition-colors pointer-events-none select-none" aria-hidden="true">┌</span>
    <span class="absolute top-2.5 right-3 text-[10px] font-mono text-[var(--color-line)] group-hover:text-indigo-400/70 transition-colors pointer-events-none select-none" aria-hidden="true">┐</span>
    <span class="absolute bottom-2.5 left-3 text-[10px] font-mono text-[var(--color-line)] group-hover:text-indigo-400/70 transition-colors pointer-events-none select-none" aria-hidden="true">└</span>
    <span class="absolute bottom-2.5 right-3 text-[10px] font-mono text-[var(--color-line)] group-hover:text-indigo-400/70 transition-colors pointer-events-none select-none" aria-hidden="true">┘</span>

    <!-- Dynamic Specular Aurora Sheen -->
    <div
      class="pointer-events-none absolute -inset-px rounded-[var(--radius-tile)] opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-tr from-indigo-500/10 via-transparent to-emerald-500/10 z-10"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[var(--color-line)] pb-4">
      <div class="flex items-center gap-3">
        <StatusPill status={p.status} />
        <span class="text-xs font-mono font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">
          Architectural Spotlight · Flagship {orderNumber}
        </span>
      </div>
      <div class="flex items-center gap-1.5 flex-wrap">
        {allStack.slice(0, 5).map(tech => <TechBadge name={tech} />)}
      </div>
    </div>

    <div class="relative z-10 my-5 grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
      <div class="lg:col-span-2 space-y-3">
        <h3 class="font-display font-bold text-2xl sm:text-3xl text-[var(--color-ink)] group-hover:text-indigo-500 transition-colors">
          {p.title}
        </h3>
        <p class="text-sm sm:text-base text-[var(--color-ink-muted)] leading-relaxed">
          {p.tagline}
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 pt-2 text-xs font-mono text-[var(--color-ink-muted)]">
          <div class="p-2.5 rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-line)]">
            <span class="text-indigo-600 dark:text-indigo-400 font-bold block">0 Internet</span>
            <span>Local Hotspot Server</span>
          </div>
          <div class="p-2.5 rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-line)]">
            <span class="text-indigo-600 dark:text-indigo-400 font-bold block">WebSockets</span>
            <span>Live Sync Slides & Polls</span>
          </div>
          <div class="p-2.5 rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-line)] col-span-2 sm:col-span-1">
            <span class="text-indigo-600 dark:text-indigo-400 font-bold block">67 Diagrams</span>
            <span>Technical Schematics</span>
          </div>
        </div>
      </div>

      <div class="flex flex-col justify-center items-start lg:items-end gap-3 p-4 rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-line)]">
        <span class="text-xs font-mono text-[var(--color-ink-muted)]">Offline Wi-Fi Hub</span>
        <button
          type="button"
          data-project={project.id}
          class="case-study-trigger tactile-press w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white hover:bg-indigo-700 transition-all shadow-xs cursor-pointer"
        >
          <span>Explore Architecture & Schematics</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <div class="relative z-10 pt-2 text-xs font-mono text-[var(--color-ink-muted)] flex items-center justify-between">
      <span>{p.domainLabel}</span>
      <span>Express + SQLite WAL + Socket.io</span>
    </div>
  </div>
)}

{featuredTier === 'standard' && (
  <div
    class="scroll-reveal bento-stagger cyber-card group relative overflow-hidden flex flex-col justify-between rounded-[var(--radius-tile)] bg-[var(--color-surface)] border border-[var(--color-line)] p-5 transition-all duration-300 hover:border-[var(--color-accent)]/60 hover:shadow-lg hover:shadow-emerald-950/15 focus-within:ring-2 focus-within:ring-[var(--color-accent)]"
    style={`--i: ${index};`}
    data-sound-hover="true"
  >
    <!-- Dynamic Specular Cursor-Tracked Light Sheen -->
    <div class="specular-sheen" aria-hidden="true"></div>

    <!-- Cybernetic HUD Corner Brackets -->
    <span class="absolute top-2 left-2 text-[8px] font-mono text-[var(--color-line)] group-hover:text-emerald-500/60 transition-colors pointer-events-none select-none" aria-hidden="true">┌</span>
    <span class="absolute top-2 right-2 text-[8px] font-mono text-[var(--color-line)] group-hover:text-emerald-500/60 transition-colors pointer-events-none select-none" aria-hidden="true">┐</span>
    <span class="absolute bottom-2 left-2 text-[8px] font-mono text-[var(--color-line)] group-hover:text-emerald-500/60 transition-colors pointer-events-none select-none" aria-hidden="true">└</span>
    <span class="absolute bottom-2 right-2 text-[8px] font-mono text-[var(--color-line)] group-hover:text-emerald-500/60 transition-colors pointer-events-none select-none" aria-hidden="true">┘</span>

    <!-- Dynamic Specular Aurora Sheen -->
    <div
      class="pointer-events-none absolute -inset-px rounded-[var(--radius-tile)] opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-tr from-emerald-500/10 via-transparent to-indigo-500/10 z-10"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <StatusPill status={p.status} />
        <span class="text-[11px] font-mono text-[var(--color-ink-muted)]">Flagship {orderNumber}</span>
      </div>
      <span class="text-[11px] font-mono text-[var(--color-ink-muted)] truncate">{p.domainLabel}</span>
    </div>

    <div class="relative z-10 my-3 space-y-1.5">
      <h4 class="font-display font-semibold text-lg text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors line-clamp-1">
        {p.title}
      </h4>
      <p class="text-xs text-[var(--color-ink-muted)] line-clamp-2 leading-relaxed">
        {p.tagline}
      </p>
    </div>

    <div class="relative z-10 flex items-center justify-between pt-3 border-t border-[var(--color-line)] gap-2">
      <div class="flex items-center gap-1 overflow-hidden flex-wrap">
        {topBadges.slice(0, 2).map(tech => <TechBadge name={tech} />)}
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        {p.status === 'live' && p.links.live && (
          <a
            href={p.links.live}
            target="_blank"
            rel="noopener noreferrer"
            class="tactile-press text-[11px] font-medium text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-0.5"
            title="Open Live App"
          >
            <span>Live</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
        <button
          type="button"
          data-project={project.id}
          class="case-study-trigger tactile-press text-xs font-medium text-[var(--color-ink-muted)] hover:text-[var(--color-accent)] flex items-center gap-1 cursor-pointer p-1"
        >
          <span>View</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
)}
