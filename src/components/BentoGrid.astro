---
import type { CollectionEntry } from 'astro:content';
import BentoTile from './BentoTile.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

// Filter and sort the 6 marquee bento flagship projects
const flagships = projects
  .filter(p => p.data.bentoOrder !== null)
  .sort((a, b) => (a.data.bentoOrder || 0) - (b.data.bentoOrder || 0));
---

<section class="w-full my-8">
  <div class="mb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
    <div>
      <h2 class="font-display font-bold text-2xl sm:text-3xl text-[var(--color-ink)]">
        Flagship Systems
      </h2>
      <p class="text-sm text-[var(--color-ink-muted)]">
        Marquee institutional platforms, offline engines, and civic tools.
      </p>
    </div>
    <span class="text-xs font-mono text-[var(--color-ink-muted)]">
      6 Flagships · 100% Operational
    </span>
  </div>

  <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-6 lg:auto-rows-[minmax(180px,1fr)]">
    {flagships.map((project, idx) => (
      <BentoTile project={project} index={idx} />
    ))}
  </div>
</section>
